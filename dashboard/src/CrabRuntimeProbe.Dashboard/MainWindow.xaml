<Window x:Class="CrabRuntimeProbe.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrabRuntimeProbe - CrabSync Evidence Dashboard"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22" Background="{StaticResource PageBrush}" TextElement.Foreground="{StaticResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="CrabSync evidence campaign"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                           Text="Exhaustive, catalog-driven, passive observation - writes, RPC calls, mutation, HUD hooks, and raw identity stay disabled"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentDarkBrush}" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="READ-ONLY SAFETY MODEL"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SmallLabel}" Text="CAMPAIGN NAME"/>
                    <TextBox Text="{Binding CampaignName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SmallLabel}" Text="CRAB CHAMPIONS INSTALLATION"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding BrowseGameCommand}" Content="Browse..." Margin="8,0,0,0" Padding="12,7"/>
                        <Button DockPanel.Dock="Right" Command="{Binding DetectGameCommand}" Content="Detect" Margin="8,0,0,0" Padding="12,7"/>
                        <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SmallLabel}" Text="THIS COMPUTER"/>
                    <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" Margin="0,6,0,0">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D1423"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F7FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#143E3C"/>
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>
                <WrapPanel Grid.Column="3" VerticalAlignment="Bottom" MaxWidth="510">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrepareAndStartCommand}" Content="Prepare / Start Campaign"/>
                    <Button Command="{Binding PrepareCommand}" Content="Prepare"/>
                    <Button Command="{Binding StartMonitoringCommand}" Content="Start Monitoring"/>
                    <Button Command="{Binding ResumeCommand}" Content="Resume"/>
                    <Button Command="{Binding OpenGameCommand}" Content="Open Game"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource SmallLabel}" Text="RUNTIME"/><TextBlock Style="{StaticResource Metric}" Text="{Binding RuntimeSummary}" Foreground="{Binding Snapshot.Runtime.RuntimeProbeState, Converter={StaticResource StatusBrushConverter}}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource SmallLabel}" Text="ROLE / AUTHORITY"/><TextBlock Style="{StaticResource Metric}" Text="{Binding RoleSummary}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource SmallLabel}" Text="LIFECYCLE"/><TextBlock Style="{StaticResource Metric}" Text="{Binding LifecycleSummary}" Foreground="{Binding Snapshot.Lifecycle.State, Converter={StaticResource StatusBrushConverter}}"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource SmallLabel}" Text="EVIDENCE"/><TextBlock Style="{StaticResource Metric}" Text="{Binding EvidenceSummary}" Foreground="{Binding Snapshot.EvidenceHealth.State, Converter={StaticResource StatusBrushConverter}}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel><TextBlock Style="{StaticResource SmallLabel}" Text="HEARTBEAT"/><TextBlock Style="{StaticResource Metric}" Text="{Binding HeartbeatSummary}" Foreground="{Binding Status.IsStale, Converter={StaticResource StatusBrushConverter}, ConverterParameter=stale}"/></StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="RootTabs" Grid.Row="3" Background="Transparent" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PageBrush}">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Campaign health"/>
                                    <TextBlock FontSize="16" Margin="0,14,0,4" Text="{Binding ChecklistSummary}"/>
                                    <TextBlock FontSize="16" Margin="0,4" Text="{Binding CoverageSummary}"/>
                                    <UniformGrid Columns="3" Margin="0,12,0,5">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource SmallLabel}" Text="CAMPAIGN / SESSION"/>
                                            <TextBlock Text="{Binding CampaignIdentitySummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CampaignIdentitySummary}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource SmallLabel}" Text="PROBE STAGE / ELAPSED"/>
                                            <TextBlock><Run Text="{Binding ProbeStageSummary, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding ElapsedSummary, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SmallLabel}" Text="CHECKLIST COMPLETION"/>
                                            <TextBlock Text="{Binding ChecklistCompletionSummary}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CrashBadge}" Foreground="{Binding Snapshot.CrashSuspected, Converter={StaticResource StatusBrushConverter}, ConverterParameter=alert}"/>
                                        </Border>
                                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding DirtyBadge}" Foreground="{Binding IsDirtyEvidence, Converter={StaticResource StatusBrushConverter}, ConverterParameter=alert}"/>
                                        </Border>
                                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="{Binding IncompleteBadge}" Foreground="{StaticResource StateYellowBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="A registered hook is only a readiness signal. Checklist completion requires qualifying natural gameplay evidence, and catalog completion requires a clean terminal disposition for every material row."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Safety circuit breakers"/>
                                    <UniformGrid Columns="5" Margin="0,13,0,0">
                                        <TextBlock FontSize="10" Margin="0,0,6,0" Foreground="{Binding Snapshot.Safety.WritesDisabled, Converter={StaticResource StatusBrushConverter}}"><Run Text="Writes disabled: "/><Run Text="{Binding Snapshot.Safety.WritesDisabled, Mode=OneWay}"/></TextBlock>
                                        <TextBlock FontSize="10" Margin="0,0,6,0" Foreground="{Binding Snapshot.Safety.RpcsDisabled, Converter={StaticResource StatusBrushConverter}}"><Run Text="RPC calls disabled: "/><Run Text="{Binding Snapshot.Safety.RpcsDisabled, Mode=OneWay}"/></TextBlock>
                                        <TextBlock FontSize="10" Margin="0,0,6,0" Foreground="{Binding Snapshot.Safety.MutationDisabled, Converter={StaticResource StatusBrushConverter}}"><Run Text="Mutation disabled: "/><Run Text="{Binding Snapshot.Safety.MutationDisabled, Mode=OneWay}"/></TextBlock>
                                        <TextBlock FontSize="10" Margin="0,0,6,0" Foreground="{Binding Snapshot.Safety.HudHookDisabled, Converter={StaticResource StatusBrushConverter}}"><Run Text="HUD hook disabled: "/><Run Text="{Binding Snapshot.Safety.HudHookDisabled, Mode=OneWay}"/></TextBlock>
                                        <TextBlock FontSize="10" Foreground="{Binding Snapshot.Safety.RawIdentityDisabled, Converter={StaticResource StatusBrushConverter}}"><Run Text="Raw identity disabled: "/><Run Text="{Binding Snapshot.Safety.RawIdentityDisabled, Mode=OneWay}"/></TextBlock>
                                    </UniformGrid>
                                    <TextBlock Margin="0,10,0,0"><Run Foreground="{StaticResource MutedBrush}" Text="Inventory depth: "/><Run Text="{Binding InventoryDepthSummary, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding CircuitBreakerSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Required final capability statement"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" Text="No category is complete when its denominator is missing."/>
                                <ItemsControl ItemsSource="{Binding Readiness}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Category}"/>
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Foreground="{Binding Complete, Converter={StaticResource StatusBrushConverter}}" Margin="14,0,0,0">
                                                        <Run Text="{Binding ClosedRows, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalRows, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Action checklist">
                <ListView ItemsSource="{Binding ChecklistView}" Background="{StaticResource PanelBrush}" BorderThickness="0"
                          ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,18,10,8" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Name}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource StatusBrushConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Instruction}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="3" Text="{Binding ObservationCount}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,14,0" Text="{Binding FirstObservedDisplay, StringFormat=first: {0}}"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,14,0" Text="{Binding LastObservedDisplay, StringFormat=latest: {0}}"/>
                                    <TextBlock Foreground="{StaticResource StateBlueBrush}" FontSize="10" Margin="0,0,14,0" Text="{Binding SourcesDisplay, StringFormat=source: {0}}"/>
                                    <TextBlock Foreground="{StaticResource StateGrayBrush}" FontSize="10" Text="{Binding EvidenceSessionsDisplay, StringFormat=session: {0}}"/>
                                </WrapPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>

            <TabItem Header="Coverage catalog">
                <Grid Margin="10" Background="{StaticResource PageBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding CoverageSummary}" FontWeight="SemiBold"/>
                        <CheckBox DockPanel.Dock="Right" Content="Needs Coverage only" IsChecked="{Binding NeedsCoverageOnly}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CoverageView}" SelectedItem="{Binding SelectedCoverage}"
                              AutoGenerateColumns="False" FrozenColumnCount="3" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="Symbol / path" Binding="{Binding SymbolPath}" Width="420"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                            <DataGridTextColumn Header="Read" Binding="{Binding ReadStatus}" Width="150"/>
                            <DataGridTextColumn Header="Natural observation" Binding="{Binding NaturalObservationStatus}" Width="180"/>
                            <DataGridTextColumn Header="Args / metadata" Binding="{Binding ArgumentMetadataStatus}" Width="220"/>
                            <DataGridTextColumn Header="Ownership / authority" Binding="{Binding OwnershipAuthorityStatus}" Width="240"/>
                            <DataGridTextColumn Header="Visibility direction" Binding="{Binding VisibilityDirection}" Width="230"/>
                            <DataGridTextColumn Header="Lifecycle" Binding="{Binding LifecycleCoverage}" Width="180"/>
                            <DataGridTextColumn Header="Persistence / UI" Binding="{Binding PersistenceUiCoverage}" Width="210"/>
                            <DataGridTextColumn Header="Write / apply" Binding="{Binding WriteApplyStatus}" Width="240"/>
                            <DataGridTextColumn Header="Safety" Binding="{Binding SafetyClassification}" Width="190"/>
                            <DataGridTextColumn Header="Disposition" Binding="{Binding TerminalDisposition}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding TerminalDisposition, Converter={StaticResource StatusBrushConverter}}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Next observation" Binding="{Binding NextRequiredObservation}" Width="380"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabel}" Text="SELECTED CANDIDATE"/>
                                <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,5" Text="{Binding SelectedCoverage.SymbolPath}" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding SelectedCoverage.Relevance}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Style="{StaticResource SmallLabel}" Text="NEXT REQUIRED OBSERVATION"/>
                                <TextBlock Margin="0,5" Text="{Binding SelectedCoverage.NextRequiredObservation}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SmallLabel}" Margin="0,9,0,0" Text="CHECKLIST LINKAGE"/>
                                <ItemsControl ItemsSource="{Binding SelectedCoverage.ChecklistLinks}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="8,3" Margin="0,5,5,0"><TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reports &amp; bundles">
                <Grid Margin="18" Background="{StaticResource PageBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Evidence bundle"/>
                            <TextBlock Margin="0,8,0,15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Canonical JSON/JSONL is copied byte-for-byte only after safety and identity validation. Logs are redacted derivatives. Every included file is size- and SHA-256-indexed."/>
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Content="Finish &amp; Collect"/>
                                <Button Command="{Binding OpenLastBundleCommand}" Content="Open Evidence Folder"/>
                                <Button Command="{Binding ViewDiagnosticsCommand}" Content="View Diagnostic Summary"/>
                                <Button Command="{Binding SupportSummaryCommand}" Content="Copy Support Summary"/>
                                <Button Command="{Binding StopCommand}" Content="Stop Observation"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SmallLabel}" Margin="0,15,0,4" Text="LAST BUNDLE"/>
                            <TextBlock Text="{Binding LastBundle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Host + joined client"/>
                            <TextBlock Margin="0,8,0,15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Strict correlation requires compatible schema, profile and catalog hashes; opposite roles; unique anonymous machine and runtime session IDs; matching normalized campaign names; overlapping capture intervals; and clean evidence."/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CombineCommand}" Content="Combine Evidence Bundles" HorizontalAlignment="Left"/>
                            <TextBlock Margin="0,15,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Offline pairing does not itself prove remote visibility. The combined report preserves that limitation and generates a capability readiness statement."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Activity}"/>
            <Button Grid.Column="1" Command="{Binding ResetCommand}" Content="Reset Dashboard State" Padding="11,6" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
