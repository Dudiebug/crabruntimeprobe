{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dudiebug.github.io/crabruntimeprobe/schemas/evidence-bundle-v1.schema.json",
  "title": "CrabRuntimeProbe evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleFormat",
    "campaignId",
    "campaignName",
    "profileId",
    "campaignGeneration",
    "machineId",
    "sessionId",
    "selectedRole",
    "preparedAtUtc",
    "collectedAtUtc",
    "crashSuspected",
    "dirtyEvidence",
    "evidenceFileCount",
    "catalogSchemaVersion",
    "catalogHash",
    "safety",
    "manifestSelfExcluded",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleFormat": { "const": "crabruntimeprobe-evidence-bundle-v1" },
    "campaignId": { "type": "string", "minLength": 1 },
    "campaignName": { "type": "string", "minLength": 1 },
    "profileId": { "enum": ["crabsync-full-observe", "crabsync-readiness-campaign", "progressive-broad-observation"] },
    "campaignGeneration": { "type": "integer", "minimum": 1 },
    "machineId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "selectedRole": { "enum": ["host", "joined-client"] },
    "preparedAtUtc": { "type": "string", "format": "date-time" },
    "collectedAtUtc": { "type": "string", "format": "date-time" },
    "crashSuspected": { "type": "boolean" },
    "dirtyEvidence": { "type": "boolean" },
    "evidenceFileCount": { "type": "integer", "minimum": 0 },
    "catalogSchemaVersion": { "type": "string", "minLength": 1 },
    "catalogHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writesDisabled",
        "rpcCallsDisabled",
        "mutationDisabled",
        "rawIdentityDisabled",
        "hudHookDisabled",
        "hooksDisabled",
        "runtimeDiscoveryDisabled",
        "inventoryStagesDisabled",
        "controlledResearchHooks",
        "compatibilityValidated",
        "trustedDepthEnforced",
        "activeCanaries"
      ],
      "properties": {
        "writesDisabled": { "type": "boolean" },
        "rpcCallsDisabled": { "type": "boolean" },
        "mutationDisabled": { "type": "boolean" },
        "rawIdentityDisabled": { "type": "boolean" },
        "hudHookDisabled": { "type": "boolean" },
        "hooksDisabled": { "type": "boolean" },
        "runtimeDiscoveryDisabled": { "type": "boolean" },
        "inventoryStagesDisabled": { "type": "boolean" },
        "controlledResearchHooks": { "type": "boolean" },
        "compatibilityValidated": { "type": "boolean" },
        "trustedDepthEnforced": { "type": "boolean" },
        "activeCanaries": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "manifestSelfExcluded": { "const": true },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "hash", "sourceHash", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "(^[A-Za-z]:|^[/\\\\]|\\.\\.)" }
          },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "sourceHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "kind": {
            "enum": [
              "canonical-byte-copy",
              "provenance-byte-copy",
              "crash-metadata-only",
              "redacted-derivative",
              "generated-report"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profileId": { "const": "crabsync-full-observe" } } },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "writesDisabled": { "const": true },
              "rpcCallsDisabled": { "const": true },
              "mutationDisabled": { "const": true },
              "rawIdentityDisabled": { "const": true },
              "hudHookDisabled": { "const": true },
              "hooksDisabled": { "const": true },
              "runtimeDiscoveryDisabled": { "const": true },
              "inventoryStagesDisabled": { "const": true },
              "controlledResearchHooks": { "const": false },
              "compatibilityValidated": { "const": false },
              "trustedDepthEnforced": { "const": false },
              "activeCanaries": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "progressive-broad-observation" } } },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "writesDisabled": { "const": true },
              "rpcCallsDisabled": { "const": true },
              "mutationDisabled": { "const": true },
              "rawIdentityDisabled": { "const": true },
              "hudHookDisabled": { "const": true },
              "runtimeDiscoveryDisabled": { "const": true },
              "inventoryStagesDisabled": { "const": true },
              "controlledResearchHooks": { "const": true },
              "compatibilityValidated": { "const": true },
              "trustedDepthEnforced": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "crabsync-readiness-campaign" } } },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "writesDisabled": { "const": true },
              "rpcCallsDisabled": { "const": true },
              "mutationDisabled": { "const": true },
              "rawIdentityDisabled": { "const": true },
              "hudHookDisabled": { "const": true },
              "hooksDisabled": { "const": true },
              "runtimeDiscoveryDisabled": { "const": true },
              "inventoryStagesDisabled": { "const": true },
              "controlledResearchHooks": { "const": false },
              "compatibilityValidated": { "const": false },
              "trustedDepthEnforced": { "const": false },
              "activeCanaries": { "const": 0 }
            }
          }
        }
      }
    }
  ]
}
