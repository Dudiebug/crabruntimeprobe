{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dudiebug.github.io/crabruntimeprobe/schemas/readiness-campaign-manifest-v1.schema.json",
  "title": "CrabRuntimeProbe readiness campaign manifest v1",
  "description": "A local, read-only campaign contract for collecting paired CrabSync readiness evidence. The human-entered correlation code is intentionally not persisted here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "campaignId", "campaignGeneration", "sessionId", "machineId", "selectedRole", "profileId", "pairId", "preparedAtUtc", "inventoryStage", "enabledChannels", "peerSnapshotsEnabled", "maxPeers", "intervals", "safety"],
  "properties": {
    "schemaVersion": { "const": "readiness-campaign-manifest-v1" },
    "manifestId": { "$ref": "#/$defs/id" },
    "campaignId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "campaignGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sessionId": { "$ref": "#/$defs/id" },
    "machineId": { "$ref": "#/$defs/id" },
    "selectedRole": { "enum": ["host", "joined-client"] },
    "profileId": { "const": "crabsync-readiness-campaign" },
    "pairId": { "$ref": "#/$defs/pairId" },
    "preparedAtUtc": { "type": "string", "format": "date-time", "maxLength": 64 },
    "inventoryStage": { "const": "disabled" },
    "enabledChannels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["health", "crystals", "slots", "equipment", "peer-snapshots"] }
    },
    "peerSnapshotsEnabled": { "const": true },
    "maxPeers": { "type": "integer", "minimum": 1, "maximum": 4 },
    "intervals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthSeconds", "scalarSeconds", "inventorySeconds", "unchangedHeartbeatSeconds"],
      "properties": {
        "healthSeconds": { "type": "number", "minimum": 0.25, "maximum": 5 },
        "scalarSeconds": { "type": "number", "minimum": 1, "maximum": 60 },
        "inventorySeconds": { "type": "number", "minimum": 2, "maximum": 120 },
        "unchangedHeartbeatSeconds": { "type": "number", "minimum": 10, "maximum": 600 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "writeProbes", "rpcCalls", "mutation", "hooks", "runtimeDiscovery", "deepInventory", "rawIdentity"],
      "properties": {
        "readOnly": { "const": true },
        "writeProbes": { "const": false },
        "rpcCalls": { "const": false },
        "mutation": { "const": false },
        "hooks": { "const": false },
        "runtimeDiscovery": { "const": false },
        "deepInventory": { "const": false },
        "rawIdentity": { "const": false }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pairId": {
      "type": "string",
      "pattern": "^readiness-pair-[a-f0-9]{24}$"
    }
  }
}
