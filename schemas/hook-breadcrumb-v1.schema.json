{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dudiebug.github.io/crabruntimeprobe/schemas/hook-breadcrumb-v1.schema.json",
  "title": "CrabRuntimeProbe minimal hook breadcrumb v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "runId", "candidateId", "hookPathFingerprint", "validationDepth", "candidateRole", "invocationId", "phase", "boundary", "lifecycleGeneration", "timestampUtc", "monotonicMicros"],
  "properties": {
    "schemaVersion": { "const": "hook-breadcrumb-v1" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "runId": { "$ref": "#/$defs/id" },
    "candidateId": { "type": "string", "pattern": "^hook-[a-z0-9-]{3,120}$", "maxLength": 128 },
    "hookPathFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validationDepth": { "type": "integer", "minimum": 1, "maximum": 7 },
    "candidateRole": { "enum": ["trusted", "canary"] },
    "invocationId": { "$ref": "#/$defs/id" },
    "phase": { "enum": ["registration", "pre", "post", "blueprint-post-only", "runtime"] },
    "boundary": { "enum": ["registration-begin", "registration-complete", "registration-failed", "callback-enter", "context-resolve-begin", "context-resolve-complete", "scope-resolve-begin", "scope-resolve-complete", "prestate-read-begin", "prestate-read-complete", "arguments-read-begin", "arguments-read-complete", "poststate-read-begin", "poststate-read-complete", "evidence-write-begin", "evidence-write-complete", "callback-exit", "run-complete"] },
    "lifecycleGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestampUtc": { "type": "string", "format": "date-time", "maxLength": 64 },
    "monotonicMicros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" } }
}
